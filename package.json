{
  "name": "claudespace",
  "productName": "ClaudeSpace",
  "version": "0.7.9",
  "description": "Desktop app for working with Claude Code on a VM over SSH",
  "private": true,
  "license": "MIT",
  "author": "ClaudeSpace contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/dZatr1k/ClaudeSpace.git"
  },
  "homepage": "https://github.com/dZatr1k/ClaudeSpace",
  "bugs": {
    "url": "https://github.com/dZatr1k/ClaudeSpace/issues"
  },
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "npm run agent:manifest && electron-vite dev",
    "dev:vm": "npm run agent:manifest && electron-vite dev --noSandbox",
    "build": "npm run agent:manifest && npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "start:vm": "electron-vite preview --noSandbox",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "test": "npm run test:agent && npm run test:unit",
    "test:unit": "vitest run",
    "test:agent": "python3 -m unittest discover -s agent/tests -t agent",
    "test:e2e": "playwright test",
    "agent:manifest": "python3 agent/build_manifest.py",
    "agent:install": "python3 agent/build_manifest.py --install",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "release": "node scripts/release.mjs",
    "icon": "python3 scripts/make-icon.py",
    "splash": "vite --config vite.splash.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-virtual": "3.14.26",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "6.2.1",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "cmdk": "1.1.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "highlight.js": "11.12.0",
    "lucide-react": "1.70.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zustand": "5.1.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "ssh-config": "5.3.0",
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  }
}
